# --- Supabase ---
# Project URL (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# SECRET key (a.k.a. service_role) — server-only, full admin access.
# In the new API keys 2.0 dashboard it's labelled "secret" and starts with sb_secret_…
# DO NOT expose to the browser.
SUPABASE_SECRET_KEY=

# Storage bucket name (create it as a PRIVATE bucket in Supabase Studio → Storage).
SUPABASE_BUCKET=audio

# --- Postgres (Supabase) ---
# Use the *transaction pooler* URL from Supabase Studio → Settings → Database → Connection string.
# Looks like: postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Reserved for v2 (invite-code gate). Not used in v1.
# INVITE_CODE=
